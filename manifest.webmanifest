{
  "id": "./",
  "name": "My Maps",
  "short_name": "My Maps",
  "description": "Mark the countries you have visited, are planning, have lived in and live in now.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
